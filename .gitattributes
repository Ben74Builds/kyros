# that drives it. Its templates, stylesheet and icons outweigh everything else
# by byte count, so exclude them from linguist's statistics.
docker/kyros/app/templates/* linguist-vendored
docker/kyros/app/static/*    linguist-vendored
docker/app/templates/*       linguist-vendored
poc/app/templates/*          linguist-vendored
poc/app/static/*             linguist-vendored
*.ico                        linguist-vendored
